# Xianxia RP v0.13 — QNAP / CPU-only NAS configuration
# Fill in DISCORD_TOKEN, GUILD_ID and OPENROUTER_API_KEY before startup.

# -----------------------------------------------------------------------------
# Discord
# -----------------------------------------------------------------------------
DISCORD_TOKEN=
GUILD_ID=

# Slash commands do not need Message Content Intent.
MESSAGE_CONTENT_INTENT=false
RP_CHANNEL_IDS=
AUTO_NARRATE=false
AUTO_NARRATE_EVENT_THREADS=false
EVENT_THREAD_AUTO_ARCHIVE_MINUTES=1440

# -----------------------------------------------------------------------------
# AI narration — cloud only, no local LLM / no GPU required
# -----------------------------------------------------------------------------
NARRATOR_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Routine narration chain:
# Gemma 4 31B Free -> Gemma 4 26B A4B Free -> OpenRouter Free Models Router
OPENROUTER_ROUTINE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_ROUTINE_FALLBACK_MODEL=google/gemma-4-26b-a4b-it:free

# Epic narration chain:
# Nemotron 3 Super Free -> Gemma 4 31B Free -> OpenRouter Free Models Router
OPENROUTER_EPIC_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_EPIC_FALLBACK_MODEL=google/gemma-4-31b-it:free

# Dynamic last cloud fallback. It selects from currently available free models.
OPENROUTER_DYNAMIC_FREE_FALLBACK=openrouter/free
OPENROUTER_REQUIRE_FREE=true

# Fail over instead of making Discord users wait through long retries.
OPENROUTER_MAX_REQUESTS_PER_MINUTE=20
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_EPIC_TIMEOUT_SECONDS=60
OPENROUTER_FAILURE_COOLDOWN_SECONDS=20

# Optional OpenRouter app attribution headers.
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Xianxia RP

# Small canonical/RAG packets are intentional; large model contexts are unnecessary.
NARRATOR_CONTEXT_MAX_CHARS=4000
RAG_CONTEXT_CACHE_SECONDS=4
RAG_CANON_CACHE_SECONDS=120

# Optional direct OpenAI provider. Leave blank when using OpenRouter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# -----------------------------------------------------------------------------
# Gameplay tuning
# -----------------------------------------------------------------------------
CULTIVATE_COOLDOWN_MINUTES=180
EXPLORE_COOLDOWN_MINUTES=20
HUNT_COOLDOWN_MINUTES=30
PERFECT_QUEST_COOLDOWN_MINUTES=60
PERFECT_TRIAL_COOLDOWN_MINUTES=360
SECRET_REALM_COOLDOWN_MINUTES=15
UNEXPECTED_EVENT_CHANCE_PERCENT=28
WORLD_TIME_SCALE=4
REINCARNATION_BASE_SAMSARA_YEARS=320
REINCARNATION_MAX_WAIT_SECONDS=300

# -----------------------------------------------------------------------------
# Authoritative Go engine / SQLite WAL
# -----------------------------------------------------------------------------
DATABASE_PATH=data/xianxia.sqlite3
GAME_ENGINE_TIMEOUT_SECONDS=30

# Bot health / observability
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
SLOW_QUERY_MS=100
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=300

# -----------------------------------------------------------------------------
# GM dashboard
# -----------------------------------------------------------------------------
# startup.sh reads DASHBOARD_ENABLED. The application itself ignores this flag.
DASHBOARD_ENABLED=true
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8090
DASHBOARD_INTERNAL_PORT=8090
DASHBOARD_HOST=0.0.0.0
DASHBOARD_USERNAME=admin
DASHBOARD_ADMIN_WRITES=true
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DASHBOARD_TOKEN=
