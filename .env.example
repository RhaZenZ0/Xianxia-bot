# =============================================================================
# Xianxia RP — QNAP / CPU-only NAS configuration
# Every key below is explained, in this order, in docs/CONFIGURATION.md
# =============================================================================

# =============================================================================
# Required — the stack will not start without these
# =============================================================================
DISCORD_TOKEN=
GUILD_ID=
OPENROUTER_API_KEY=
ENGINE_AUTH_TOKEN=
DASHBOARD_TOKEN=

# =============================================================================
# Discord
# =============================================================================
MESSAGE_CONTENT_INTENT=true
RP_CHANNEL_IDS=
AUTO_NARRATE=false
AUTO_NARRATE_EVENT_THREADS=false
EVENT_THREAD_AUTO_ARCHIVE_MINUTES=1440

# --- Typed play --------------------------------------------------------------
TYPED_PLAY_PREFIX=$
TYPED_PLAY_BURST=4
TYPED_PLAY_PER_MINUTE=6
TYPED_PLAY_HINT=true

# --- Administrator chat monitor ----------------------------------------------
MONITOR_MAX_MESSAGES=400
MONITOR_LOOKBACK_HOURS=24
MONITOR_CHUNK_CHARS=6000
MONITOR_MAX_CHUNKS=6

# =============================================================================
# AI narration — cloud only, no GPU required
# =============================================================================
NARRATOR_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Optional: direct Google AI Studio route ---------------------------------
GOOGLE_AI_STUDIO_API_KEY=
GOOGLE_AI_STUDIO_MODEL=aistudio/gemini-3.8-flash

# --- Narration chains --------------------------------------------------------
OPENROUTER_ROUTINE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_ROUTINE_FALLBACK_MODEL=
OPENROUTER_EPIC_MODEL=google/gemma-4-31b-it:free
OPENROUTER_EPIC_FALLBACK_MODEL=
OPENROUTER_DISABLE_REASONING=true
OPENROUTER_DYNAMIC_FREE_FALLBACK=openrouter/free
OPENROUTER_REQUIRE_FREE=true

# --- Budgets, timeouts and context -------------------------------------------
OPENROUTER_MAX_REQUESTS_PER_MINUTE=20
OPENROUTER_MAX_REQUESTS_PER_DAY=50
OPENROUTER_CREDITS_TOPPED_UP=false
OPENROUTER_ROUTE_REQUESTS_PER_MINUTE=15
OPENROUTER_ROUTE_REQUESTS_PER_DAY=1500
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_EPIC_TIMEOUT_SECONDS=60
OPENROUTER_FAILURE_COOLDOWN_SECONDS=20
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Xianxia RP
NARRATOR_CONTEXT_MAX_CHARS=4000
RAG_CONTEXT_CACHE_SECONDS=4
RAG_CANON_CACHE_SECONDS=120

# =============================================================================
# Gameplay tuning
# =============================================================================
CULTIVATE_COOLDOWN_MINUTES=180
EXPLORE_COOLDOWN_MINUTES=20
HUNT_COOLDOWN_MINUTES=30
PERFECT_QUEST_COOLDOWN_MINUTES=60
PERFECT_TRIAL_COOLDOWN_MINUTES=360
SECRET_REALM_COOLDOWN_MINUTES=15
UNEXPECTED_EVENT_CHANCE_PERCENT=28
WORLD_TIME_SCALE=4
REINCARNATION_BASE_SAMSARA_YEARS=320
REINCARNATION_MAX_WAIT_SECONDS=300

# --- Quest Forge -------------------------------------------------------------
QUEST_FORGE_AUTO=false
QUEST_FORGE_MIN_SIGNIFICANCE=80
QUEST_FORGE_INTERVAL_HOURS=6
QUEST_REWARD_MAX_XP=50
QUEST_REWARD_MAX_STONES=200
QUEST_REWARD_MAX_ITEMS=3

# =============================================================================
# Authoritative Go engine / SQLite WAL
# =============================================================================
DATABASE_PATH=data/xianxia.sqlite3
GAME_ENGINE_TIMEOUT_SECONDS=30
# ENGINE_SHUTDOWN_GRACE_SECONDS=20

# =============================================================================
# Health, limits and alerting
# =============================================================================
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8082
HTTP_MAX_REQUEST_LINE_BYTES=8192
HTTP_MAX_HEADER_LINES=100
HTTP_MAX_HEADER_BYTES=16384
HTTP_HEADER_DEADLINE_SECONDS=10
HTTP_HEADER_LINE_TIMEOUT_SECONDS=5
HTTP_MAX_CONNECTIONS=64
SLOW_QUERY_MS=100
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=300

# =============================================================================
# GM dashboard
# =============================================================================
DASHBOARD_ENABLED=true
DASHBOARD_BIND_ADDRESS=0.0.0.0
DASHBOARD_PORT=8090
DASHBOARD_INTERNAL_PORT=8090
DASHBOARD_HOST=0.0.0.0
DASHBOARD_USERNAME=admin
DASHBOARD_ADMIN_WRITES=true
DASHBOARD_LOGIN_MAX_FAILURES=5
DASHBOARD_LOGIN_WINDOW_SECONDS=300
DASHBOARD_LOGIN_LOCKOUT_SECONDS=900
DASHBOARD_ALLOWED_ORIGINS=
DASHBOARD_ACTOR_ID=1
BOT_CONTROL_TOKEN=

# =============================================================================
# Release channel
# =============================================================================
UPDATE_CHECK_ENABLED=true
UPDATE_CHANNEL=stable
UPDATE_REPOSITORY=RhaZenZ0/Xianxia-bot
UPDATE_CHECK_HOURS=24

# =============================================================================
# Daily route check
# =============================================================================
ROUTE_AUDIT_HOURS=24
