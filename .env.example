# Xianxia RP v0.25.2 — QNAP / CPU-only NAS configuration
#
# Five values must be filled in. Everything below them has a working default,
# and startup.sh refuses to start until all five are present.

# =============================================================================
# Required — the stack will not start without these
# =============================================================================
DISCORD_TOKEN=
GUILD_ID=
OPENROUTER_API_KEY=

# Shared Python <-> Go engine credential. BOTH processes must carry the same
# value; it is what stops anything else on the network calling the authoritative
# engine. At least 20 characters. Generate one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ENGINE_AUTH_TOKEN=

# GM dashboard login, used with DASHBOARD_USERNAME. At least 20 characters or
# the dashboard refuses to start. Generate it the same way. The dashboard is on
# by default; set DASHBOARD_ENABLED=false further down to run without it.
DASHBOARD_TOKEN=

# =============================================================================
# Discord
# =============================================================================
# Slash commands do not need Message Content Intent. Typed play and the chat
# monitor do, and it must also be enabled in the Discord Developer Portal.
MESSAGE_CONTENT_INTENT=true

# Channels the bot narrates in. AUTO_NARRATE makes it respond to ordinary lines
# in those channels rather than only to slash commands.
RP_CHANNEL_IDS=
AUTO_NARRATE=false
AUTO_NARRATE_EVENT_THREADS=false
EVENT_THREAD_AUTO_ARCHIVE_MINUTES=1440

# --- Typed play (v0.21.1) ----------------------------------------------------
# In the channels AUTO_NARRATE listens to, a line that starts with
# TYPED_PLAY_PREFIX is an action the engine resolves ("$ I explore the ravine"
# runs /explore); a line that names an NPC who is present, or @mentions the bot,
# is dialogue; every other line is speech and costs nothing.
#
# The prefix is exactly one character, not a letter, digit or space. It is
# passed through env_file literally, so "$" needs no escaping; if your Compose
# version complains about interpolation, quote it: TYPED_PLAY_PREFIX='$'.
# ">" was the default before v0.25.1 and is still worth considering: Discord
# renders "> text" as a blockquote, so action lines look different from speech.
#
# TYPED_PLAY_BURST / TYPED_PLAY_PER_MINUTE are a per-player token bucket on
# every typed line that can reach the engine or the narrator, so one player
# cannot drain the shared OpenRouter allowance for everyone.
# TYPED_PLAY_HINT shows a player, once a day, how to use the prefix the first
# time an un-prefixed line of theirs looks like an action.
TYPED_PLAY_PREFIX=$
TYPED_PLAY_BURST=4
TYPED_PLAY_PER_MINUTE=6
TYPED_PLAY_HINT=true

# --- Administrator chat monitor (/admin -> Server -> Chat Digest) ------------
# Reads Discord message history and summarises it through the SAME free
# OpenRouter chain as narration, so it can never spend money. The ceilings
# exist because both share the OPENROUTER_MAX_REQUESTS_PER_MINUTE limiter.
# MESSAGE_CONTENT_INTENT above must be true AND Message Content Intent must
# be enabled in the Discord Developer Portal, or history comes back empty.
MONITOR_MAX_MESSAGES=400
MONITOR_LOOKBACK_HOURS=24
MONITOR_CHUNK_CHARS=6000
MONITOR_MAX_CHUNKS=6

# =============================================================================
# AI narration — cloud only, no local LLM / no GPU required
# =============================================================================
# OPENROUTER_API_KEY is at the top of this file with the other required values.
NARRATOR_PROVIDER=openrouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Routine narration chain (v0.19.38 defaults):
# Gemma 4 31B Free -> MiniMax M3 Free -> OpenRouter Free Models Router
#
# Gemma's ":free" route is served by Google AI Studio ALONE, and Google's
# shared free pool rate-limits per user (in production: 429 on 30 of 30
# attempts). It is only a good primary if you have added your own Google AI
# Studio key on https://openrouter.ai/settings/integrations - the AI Studio
# integration, not Vertex - and SAVED it; then it runs on your own AI Studio
# quota, which is far larger. Check /admin server ai_status: each route says
# which upstream served it and whether it went "via your own provider key" or
# via the shared pool. On that key, set "shared capacity fallback" to "never
# use shared capacity for models this key applies to", so a failure of YOUR
# key shows up in ai_status as Google's error instead of the pool's 429.
# Without a key, put MiniMax first: OPENROUTER_ROUTINE_MODEL=minimax/minimax-m3:free
# (any route at "NEVER SUCCEEDED" is costing a daily free-tier slot per retry).
OPENROUTER_ROUTINE_MODEL=google/gemma-4-31b-it:free
OPENROUTER_ROUTINE_FALLBACK_MODEL=minimax/minimax-m3:free

# Epic narration chain (v0.19.38 defaults):
# Gemma 4 31B Free -> GLM 5.2 Free -> OpenRouter Free Models Router
# (Nemotron 3 Super narrated its own instructions 3 of 3 times and was dropped.)
OPENROUTER_EPIC_MODEL=google/gemma-4-31b-it:free
OPENROUTER_EPIC_FALLBACK_MODEL=z-ai/glm-5.2:free

# Reasoning ("thinking") is switched off on every narration request. Both
# production failures of the free chain were reasoning: models spending the
# whole token budget thinking and returning nothing, and a model returning its
# thinking AS the narration. OpenRouter turns it off on models that have it
# and ignores the setting on models that do not. Set false to let models think.
OPENROUTER_DISABLE_REASONING=true

# Dynamic last cloud fallback. It selects from currently available free models.
OPENROUTER_DYNAMIC_FREE_FALLBACK=openrouter/free
OPENROUTER_REQUIRE_FREE=true

# Fail over instead of making Discord users wait through long retries.
OPENROUTER_MAX_REQUESTS_PER_MINUTE=20
# OpenRouter's free tier is 20 requests/MINUTE and 50 requests/DAY while the
# account has under $10 of lifetime credits - 1000/day at $10 or more.
# Every failed route walks to the next one and each walk spends a daily slot,
# so the allowance drains faster than the narration count suggests.
# RAISE THIS TO 1000 once credits are on the account.
OPENROUTER_MAX_REQUESTS_PER_DAY=50
# PER-ROUTE ceilings. The two above are account-wide (OpenRouter's own);
# these are what a PROVIDER enforces per MODEL. Google allows Gemma 4 about
# 15 requests/minute and 1500/day per model - so one global 20/min ceiling
# was at once too high for a single route and too low for two of them.
# A route at its own ceiling is now SKIPPED rather than called and refused.
# These defaults are right in both regimes: on the shared free pool the
# account daily cap binds first and these never fire; with your own
# provider key (openrouter.ai/settings/integrations) they are the real one.
OPENROUTER_ROUTE_REQUESTS_PER_MINUTE=15
OPENROUTER_ROUTE_REQUESTS_PER_DAY=1500
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_EPIC_TIMEOUT_SECONDS=60
OPENROUTER_FAILURE_COOLDOWN_SECONDS=20

# Optional OpenRouter app attribution headers.
OPENROUTER_APP_URL=
OPENROUTER_APP_NAME=Xianxia RP

# Small canonical/RAG packets are intentional; large model contexts are unnecessary.
NARRATOR_CONTEXT_MAX_CHARS=4000
RAG_CONTEXT_CACHE_SECONDS=4
RAG_CANON_CACHE_SECONDS=120

# Optional direct OpenAI provider. Leave blank when using OpenRouter.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# =============================================================================
# Gameplay tuning
# =============================================================================
CULTIVATE_COOLDOWN_MINUTES=180
EXPLORE_COOLDOWN_MINUTES=20
HUNT_COOLDOWN_MINUTES=30
PERFECT_QUEST_COOLDOWN_MINUTES=60
PERFECT_TRIAL_COOLDOWN_MINUTES=360
SECRET_REALM_COOLDOWN_MINUTES=15
UNEXPECTED_EVENT_CHANCE_PERCENT=28
WORLD_TIME_SCALE=4
REINCARNATION_BASE_SAMSARA_YEARS=320
REINCARNATION_MAX_WAIT_SECONDS=300

# --- Quest Forge (v0.20.6) ---------------------------------------------------
# /admin world questforge <story> asks the narrator's free model chain to draft
# a quest from your text; it is held as a draft until you approve it on the
# dashboard's Quests page (or /admin world quests). With QUEST_FORGE_AUTO=true
# the bot also drafts one quest per notable world-history event (significance >=
# QUEST_FORGE_MIN_SIGNIFICANCE) every QUEST_FORGE_INTERVAL_HOURS - drafts only,
# never auto-approved; each costs one routine-tier request. Rewards a forged
# quest may declare are capped by the budget below and granted through the
# engine on completion. The same budget applies to quests written by hand.
QUEST_FORGE_AUTO=false
QUEST_FORGE_MIN_SIGNIFICANCE=80
QUEST_FORGE_INTERVAL_HOURS=6
QUEST_REWARD_MAX_XP=50
QUEST_REWARD_MAX_STONES=200
QUEST_REWARD_MAX_ITEMS=3

# =============================================================================
# Authoritative Go engine / SQLite WAL
# =============================================================================
DATABASE_PATH=data/xianxia.sqlite3
GAME_ENGINE_TIMEOUT_SECONDS=30

# How long the Go engine waits for in-flight requests when it is asked to stop
# (v0.22.4). It drains rather than severing connections, so a mutation that has
# already committed still gets its response written instead of leaving the
# caller unable to tell whether it happened. Keep this below the orchestrator's
# own kill timeout - docker-compose.yml gives the engine a 30s stop grace - or
# the wait is a fiction. Unset means 20 seconds.
# ENGINE_SHUTDOWN_GRACE_SECONDS=20

# =============================================================================
# Health, limits and alerting
# =============================================================================
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# HTTP request-head limits, for the health listener and the GM dashboard. Both
# parse HTTP by hand and read the request head BEFORE any authentication. A
# per-line timeout alone is not a limit: a client sending one header just under
# it holds the connection open forever (Slowloris), and a client sending them
# fast grows the header dict without bound. These are generous for a browser
# and mean for an attacker.
HTTP_MAX_REQUEST_LINE_BYTES=8192
HTTP_MAX_HEADER_LINES=100
HTTP_MAX_HEADER_BYTES=16384
HTTP_HEADER_DEADLINE_SECONDS=10
HTTP_HEADER_LINE_TIMEOUT_SECONDS=5
HTTP_MAX_CONNECTIONS=64

SLOW_QUERY_MS=100
ALERT_WEBHOOK_URL=
ALERT_COOLDOWN_SECONDS=300

# =============================================================================
# GM dashboard
# =============================================================================
# DASHBOARD_TOKEN is at the top of this file with the other required values.
#
# Five keys here look interchangeable and are not:
#   DASHBOARD_ENABLED       read by startup.sh only; the application ignores it
#   DASHBOARD_BIND_ADDRESS  which NAS interface the port is published on
#   DASHBOARD_PORT          the port you open in a browser on the NAS
#   DASHBOARD_INTERNAL_PORT the port the process listens on inside the container
#   DASHBOARD_HOST          the interface it binds inside the container
# docker-compose.yml publishes "<BIND_ADDRESS>:<PORT>:8090", so the container
# side is fixed: under Docker leave INTERNAL_PORT at 8090 and HOST at 0.0.0.0
# and change only the first two. Running outside Docker, INTERNAL_PORT is the
# port you actually connect to.
DASHBOARD_ENABLED=true
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8090
DASHBOARD_INTERNAL_PORT=8090
DASHBOARD_HOST=0.0.0.0
DASHBOARD_USERNAME=admin
DASHBOARD_ADMIN_WRITES=true

# Attributes every dashboard-originated admin write in admin_audit_log to this
# actor id instead of the unattributed default. Defaults to 1, a small integer
# that can never collide with a real Discord snowflake (17-19 digits) - which
# is what the bot's slash-command path already uses as ActorID. Set this to
# your own Discord user id instead if you'd rather dashboard actions and
# bot-command actions attribute to the same identity in the audit log.
DASHBOARD_ACTOR_ID=1

# Private dashboard -> Discord bot control. Leave blank to reuse DASHBOARD_TOKEN.
# Docker Compose supplies BOT_CONTROL_URL internally; for non-Docker local runs use http://127.0.0.1:8080.
BOT_CONTROL_TOKEN=

# =============================================================================
# Release channel (v0.20.4)
# =============================================================================
# Releases are GitHub Releases on UPDATE_REPOSITORY. The bot checks the channel
# once after startup and then every UPDATE_CHECK_HOURS, and posts "Update
# available" to the bot log channel once per newer release. Nothing is
# downloaded or installed by the bot; that stays with ./update.sh on the NAS:
#   ./update.sh --check            # ask the channel (network)
#   ./update.sh --fetch            # download + verify the newest ZIP into ./updates
#   ./update.sh --upgrade          # fetch, then install
# UPDATE_CHANNEL=stable sees full releases only; beta also sees pre-releases
# (tags like v0.21.0-beta.1). update.sh reads the same three variables.
UPDATE_CHECK_ENABLED=true
UPDATE_CHANNEL=stable
UPDATE_REPOSITORY=RhaZenZ0/Xianxia-bot
UPDATE_CHECK_HOURS=24
